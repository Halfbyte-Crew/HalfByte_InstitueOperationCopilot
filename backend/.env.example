# Backend Environment Configuration
PROJECT_NAME="EduPilot Institute Operations & Copilot"
API_V1_STR="/api/v1"
SECRET_KEY="super_secret_development_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
INSTITUTE_TIMEZONE="Asia/Kolkata"

# Administrator Root Credentials (Configured exclusively via environment)
ADMIN_EMAIL="admin@edupilot.io"
ADMIN_PASSWORD="admin123"

# Database (PostgreSQL)
DATABASE_URL="postgresql+asyncpg://edupilot_user:edupilot_password@localhost:5432/edupilot"

# AI Copilot Provider (OpenAI or Compatible)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Ollama Configuration
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_EMBEDDING_MODEL="qwen3-embedding:4b"

# CORS Origins (Comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
